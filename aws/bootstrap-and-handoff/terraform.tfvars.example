account_ids = {
  global              = "111111111111"
  core_dev            = "222222222222"
  core_prod           = "333333333333"
  shared_network_dev  = "444444444444"
  shared_network_prod = "555555555555"
}

bootstrap_profiles = {
  global              = "platform-global-admin"
  core_dev            = "core-dev-admin"
  core_prod           = "core-prod-admin"
  shared_network_dev  = "shared-network-dev-admin"
  shared_network_prod = "shared-network-prod-admin"
}

region      = "eu-central-1"
name_prefix = "example"

github = {
  organization    = "example-org"
  organization_id = "123456789"
  repositories = {
    global = { name = "tf-global-control-plane", repository_id = "100000001", environment = "global-platform" }
    core_dev = { name = "tf-infrastructure", repository_id = "100000002", environment = "core-dev" }
    core_prod = { name = "tf-infrastructure", repository_id = "100000002", environment = "core-prod" }
    shared_network_dev = { name = "tf-shared-network", repository_id = "100000003", environment = "shared-network-dev" }
    shared_network_prod = { name = "tf-shared-network", repository_id = "100000003", environment = "shared-network-prod" }
  }
}

# Replace these illustrative broad policies with service-specific policies before production.
runner_managed_policy_arns = {
  global              = ["arn:aws:iam::aws:policy/IAMFullAccess"]
  core_dev            = ["arn:aws:iam::aws:policy/PowerUserAccess"]
  core_prod           = ["arn:aws:iam::aws:policy/PowerUserAccess"]
  shared_network_dev  = ["arn:aws:iam::aws:policy/AmazonVPCFullAccess"]
  shared_network_prod = ["arn:aws:iam::aws:policy/AmazonVPCFullAccess"]
}

# Bootstrap-only permissions used by the global runner through a role in each
# non-global account. Replace these with repository-specific custom policies.
global_control_managed_policy_arns = [
  "arn:aws:iam::aws:policy/IAMFullAccess",
  "arn:aws:iam::aws:policy/AmazonS3FullAccess",
]
