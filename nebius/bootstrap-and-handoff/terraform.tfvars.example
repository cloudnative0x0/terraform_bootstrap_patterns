tenant_id = "tenant-example"
project_ids = {
  global              = "project-global"
  core_dev            = "project-core-dev"
  core_prod           = "project-core-prod"
  shared_network_dev  = "project-shared-network-dev"
  shared_network_prod = "project-shared-network-prod"
}
region      = "eu-north1"
name_prefix = "example"

github = {
  organization = "example-org", organization_id = "123456789"
  repositories = {
    global = { name = "tf-global-control-plane", repository_id = "100000001", environment = "global-platform" }
    core_dev = { name = "tf-infrastructure", repository_id = "100000002", environment = "core-dev" }
    core_prod = { name = "tf-infrastructure", repository_id = "100000002", environment = "core-prod" }
    shared_network_dev = { name = "tf-shared-network", repository_id = "100000003", environment = "shared-network-dev" }
    shared_network_prod = { name = "tf-shared-network", repository_id = "100000003", environment = "shared-network-prod" }
  }
}

# Nebius currently uses general editor/admin roles for broad infrastructure control.
runner_roles = {
  global              = ["editor"]
  core_dev            = ["editor"]
  core_prod           = ["editor"]
  shared_network_dev  = ["editor"]
  shared_network_prod = ["editor"]
}
